#Casting Explained

num1 = "1"
num2 = "2"

total = num1 + num2
print(total)

#when adding strings, the plus symbol
#becomes a concatination symbol
#this 'glues' strings together

#casting changes data types e.g.

num1 = "1"
num2 = "2"

num1ToInt = int(num1)#casting
num2ToInt = int(num2)#casting

total = num1ToInt + num2ToInt
print(total)


#we use casting lots with input e.g.

age = int(input("what is your age: "))
print(age)
